backend/storage/*.key
backend/bootstrap/cache/packages.php
backend/bootstrap/cache/services.php

# ============ 测试缓存 ============
**/.phpunit.cache
**/.phpunit.result.cache
**/coverage/

# ============ 前端构建产物 ============
frontend/passenger/.next/
frontend/passenger/out/
frontend/passenger/build/
frontend/passenger/node_modules/
frontend/passenger/next-env.d.ts
frontend/passenger/*.tsbuildinfo

# ============ IDE & OS ============
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
*.swp
*.swo

# ============ Laravel 公共存储 ============
backend/public/hot
backend/public/storage
