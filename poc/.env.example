# ====== 高德开放平台 Key（必须）======
# 申请地址: https://console.amap.com/dev/key/app
# 需要开通 Web服务 API（地理编码 + 驾车路径规划）
AMAP_KEY=your_amap_web_service_key_here

# ====== LLM API（必须，OpenAI-compatible 即可）======
# OpenRouter: https://openrouter.ai
# 火山方舟 / 智谱 / 阿里通义 / 本地 Ollama 均可
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/qwen/qwen-plus

# ====== 高德 MCP Server（可选，用于验证 MCP 接入）======
# Streamable HTTP 端点（官方推荐）
# 格式: https://mcp.amap.com/mcp?key=YOUR_AMAP_KEY
AMAP_MCP_URL=https://mcp.amap.com/mcp?key=your_amap_key_here
